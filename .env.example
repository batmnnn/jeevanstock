# Never commit real keys. Throwaway testnet keys only.
# "memory" runs fully offline with synthetic data (default). "arkiv" reads/writes Tiramisu.
DATA_SOURCE=memory

ADMIN_KEY=0x...
PAYER_KEY=0x...
# comma-separated, one per synthetic centre, same order as CENTRES in src/lib/centres.ts
CENTRE_KEYS=0x...,0x...,0x...
# staff PINs (4–8 digits), same order as CENTRES
CENTRE_PINS=1111,2222,3333
# >= 32 random chars; required in production. e.g. `openssl rand -base64 48`
SESSION_SECRET=
# 1 = show demo PINs on the staff login page (for judges). Always on in memory mode.
SHOW_DEMO_PINS=1
